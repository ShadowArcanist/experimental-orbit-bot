# Discord bot token from https://discord.com/developers/applications → Bot.
DISCORD_TOKEN=your-bot-token-here

# Discord user IDs that may use the bot (comma-separated). Everyone else is
# refused. Discord → Settings → Advanced → Developer Mode, then right-click
# your name → Copy User ID.
ALLOWED_USER_IDS=123456789012345678

# Orbit public URL (the one you open in the browser), no trailing slash.
ORBIT_URL=https://orbit.example.com
# The Orbit user the bot signs in as (see orbit-api.md §3.2.1).
ORBIT_EMAIL=orbit@example.com
ORBIT_PASSWORD=change-me

# Optional: workspace id, when the bot user is in more than one workspace.
# ORBIT_WORKSPACE_ID=
# Optional: project key used when /task add names no project.
# ORBIT_DEFAULT_PROJECT=CLFY
# Optional: IANA time zone for "Today"/"Tomorrow" deadlines on cards (default UTC).
# TIMEZONE=Europe/Berlin

# Optional log level.
RUST_LOG=info
